---
import '../styles/global.css';
import { evidence } from '../data/evidence';
import { profile } from '../data/profile';
import { asset } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Dados estruturados extras da página, além do Person e do WebSite. */
  structuredData?: readonly Record<string, unknown>[];
  /** `website` na home; `article` nos cases. */
  ogType?: 'website' | 'article';
}

const { title, description, structuredData = [], ogType = 'website' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const absolute = (path: string): string => new URL(asset(path), Astro.site).href;
const ogImage = absolute('og-image.png');
const ogAlt = `${profile.name} — ${profile.role}: ${profile.areas.join(', ')}`;
const siteUrl = absolute('');

const graph = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}#person`,
    name: profile.name,
    jobTitle: profile.role,
    description: profile.description,
    url: siteUrl,
    email: `mailto:${profile.email}`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Brasília',
      addressRegion: 'DF',
      addressCountry: 'BR',
    },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidade Cruzeiro do Sul' },
    knowsAbout: evidence.technologies
      .filter((t) => t.count >= 2 || ['Flutter', 'Astro'].includes(t.name))
      .map((t) => t.name),
    sameAs: [profile.links.linkedin, profile.links.github],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    url: siteUrl,
    name: profile.name,
    inLanguage: 'pt-BR',
    publisher: { '@id': `${siteUrl}#person` },
  },
  ...structuredData,
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#06090e" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" type="image/png" sizes="48x48" href={asset('brand/favicon.png')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!--
      Roda antes da primeira pintura, síncrono e inline. Marca que há
      JavaScript (o menu móvel e a revelação só se escondem nesse caso, para
      que sem JS o conteúdo continue visível) e liga o modo econômico em
      dispositivos modestos ou com economia de dados.
    -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        root.classList.add('js', 'js-reveal');
        const nav = navigator;
        const lite =
          (nav.connection && nav.connection.saveData === true) ||
          (nav.deviceMemory !== undefined && nav.deviceMemory <= 2) ||
          (nav.hardwareConcurrency !== undefined && nav.hardwareConcurrency <= 2);
        if (lite) root.setAttribute('data-perf', 'lite');
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
