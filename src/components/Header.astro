---
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/profile';

const links = [
  { href: '#sobre', label: 'Sobre' },
  { href: '#tecnologias', label: 'Tecnologias' },
  { href: '#projetos', label: 'Projetos' },
  { href: '#trajetoria', label: 'Trajetória' },
  { href: '#contato', label: 'Contato' },
];
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href="#topo">{profile.shortName}</a>

    <nav class="header__nav" aria-label="Navegação principal">
      <ul class="header__list">
        {
          links.map((link) => (
            <li>
              <a class="header__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 4rem;
  }

  .header__brand {
    font-weight: 650;
    font-size: var(--step-0);
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
  }

  .header__list {
    display: flex;
    gap: var(--space-md);
    margin: 0;
  }

  .header__link {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
  }

  .header__link:hover {
    color: var(--text);
  }

  /* No celular a navegação por âncora vira ruído: o conteúdo é uma página
     única e curta, então basta rolar. Marca e tema permanecem. */
  @media (max-width: 46rem) {
    .header__nav {
      display: none;
    }
  }
</style>
