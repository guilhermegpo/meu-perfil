---
import { navigation, profile } from '../data/profile';
import { asset } from '../lib/url';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  /** Na home os links rolam a página; nas outras rotas voltam para a home. */
  onHome?: boolean;
}

const { onHome = true } = Astro.props;
const home = asset('');
const target = (id: string): string => (onHome ? `#${id}` : `${home}#${id}`);
---

<div class="sentinel" data-header-sentinel aria-hidden="true"></div>

<header class="header" data-header>
  <div class="container bar">
    <a class="brand" href={onHome ? '#inicio' : home} aria-label={`${profile.name} — início`}>
      <Logo width={46} eager />
      <span class="brand__name">{profile.firstName} Pereira</span>
    </a>

    <nav id="menu" class="nav" data-menu aria-label="Principal">
      <ul class="nav__list">
        {
          navigation.map((item) => (
            <li>
              <a
                class="nav__link"
                href={target(item.id)}
                data-nav-link={item.id}
                aria-current={!onHome && item.id === 'projetos' ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="toggle"
      type="button"
      aria-controls="menu"
      aria-expanded="false"
      aria-label="Abrir menu"
      data-menu-button
    >
      <span class="toggle__open"><Icon name="menu" /></span>
      <span class="toggle__close"><Icon name="close" /></span>
    </button>
  </div>
</header>

<style>
  .sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 12px;
    pointer-events: none;
  }

  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .header:global(.is-scrolled),
  .header[data-open] {
    background: rgba(6, 9, 14, 0.9);
    border-bottom-color: var(--line);
  }

  @supports (backdrop-filter: blur(1px)) {
    .header:global(.is-scrolled),
    .header[data-open] {
      background: rgba(6, 9, 14, 0.66);
      backdrop-filter: blur(16px) saturate(1.3);
    }

    :global(html[data-perf='lite']) .header:global(.is-scrolled),
    :global(html[data-perf='lite']) .header[data-open] {
      background: rgba(6, 9, 14, 0.94);
      backdrop-filter: none;
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-sm);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand__name {
    display: none;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text-muted);
  }

  @media (min-width: 26rem) {
    .brand__name {
      display: inline;
    }
  }

  /* --- Navegação: painel no celular, linha no desktop. --- */

  .nav {
    position: absolute;
    top: 100%;
    inset-inline: 0;
    padding: var(--space-xs) var(--gutter) var(--space-sm);
    background: rgba(8, 12, 19, 0.98);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 24px 40px -24px rgba(0, 0, 0, 0.9);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 180ms var(--ease),
      transform 180ms var(--ease),
      visibility 0s linear 180ms;
  }

  .header[data-open] .nav {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  /* Sem JavaScript o menu fica aberto e legível, em vez de inacessível. */
  :global(html:not(.js)) .nav {
    position: static;
    visibility: visible;
    opacity: 1;
    transform: none;
    background: transparent;
    box-shadow: none;
    border: 0;
    padding: 0;
  }

  :global(html:not(.js)) .header {
    position: absolute;
    height: auto;
  }

  :global(html:not(.js)) .bar {
    flex-wrap: wrap;
    padding-block: var(--space-xs);
  }

  .nav__list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .nav__link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding-inline: 0.25rem;
    color: var(--text-muted);
    font-size: 1.02rem;
    text-decoration: none;
  }

  .nav__link:hover,
  .nav__link[aria-current] {
    color: var(--text);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.35rem;
    width: 1.5rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }

  .nav__link[aria-current]::after {
    transform: scaleX(1);
  }

  .toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
    font-size: 1.35rem;
    cursor: pointer;
  }

  .toggle__close,
  .header[data-open] .toggle__open {
    display: none;
  }

  .header[data-open] .toggle__close {
    display: inline-grid;
  }

  :global(html:not(.js)) .toggle {
    display: none;
  }

  @media (min-width: 62rem) {
    .nav,
    :global(html:not(.js)) .nav {
      position: static;
      padding: 0;
      background: transparent;
      border: 0;
      box-shadow: none;
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: none;
    }

    .nav__list {
      flex-direction: row;
      gap: 0.25rem;
    }

    .nav__link {
      min-height: 2.75rem;
      padding-inline: 0.8rem;
      font-size: 0.93rem;
    }

    .nav__link::after {
      left: 0.8rem;
      bottom: 0.4rem;
      width: calc(100% - 1.6rem);
    }

    .toggle {
      display: none;
    }
  }
</style>
