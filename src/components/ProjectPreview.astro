---
/**
 * Ilustrações abstratas de interface, uma por tipo de projeto.
 *
 * São desenhos, não capturas de tela: os sistemas privados e institucionais
 * não podem ter suas telas expostas, e usar prints reais para uns e desenho
 * para outros criaria uma vitrine desigual. O cartão rotula o desenho como
 * "Ilustração" para ninguém tomá-lo por um print.
 */
import type { ProjectKind } from '../data/projects';

interface Props {
  kind: ProjectKind;
}

const { kind } = Astro.props;
---

<svg class="preview" viewBox="0 0 320 180" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`pv-fill-${kind}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1b2736" />
      <stop offset="1" stop-color="#111923" />
    </linearGradient>
    <linearGradient id={`pv-accent-${kind}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#78bdf2" stop-opacity="0.9" />
      <stop offset="1" stop-color="#78bdf2" stop-opacity="0.25" />
    </linearGradient>
  </defs>

  {
    kind === 'mobile' && (
      <g>
        <rect x="52" y="14" width="86" height="156" rx="14" fill={`url(#pv-fill-${kind})`} stroke="rgba(164,214,248,.28)" />
        <rect x="84" y="20" width="22" height="4" rx="2" fill="rgba(255,255,255,.16)" />
        <rect x="62" y="34" width="66" height="22" rx="6" fill={`url(#pv-accent-${kind})`} />
        <rect x="62" y="64" width="66" height="10" rx="4" fill="rgba(255,255,255,.1)" />
        <rect x="62" y="80" width="48" height="10" rx="4" fill="rgba(255,255,255,.07)" />
        <rect x="62" y="96" width="66" height="10" rx="4" fill="rgba(255,255,255,.1)" />
        <rect x="62" y="112" width="56" height="10" rx="4" fill="rgba(255,255,255,.07)" />
        <rect x="62" y="146" width="66" height="14" rx="7" fill="rgba(120,189,242,.35)" />

        <rect x="156" y="34" width="112" height="60" rx="10" fill={`url(#pv-fill-${kind})`} stroke="rgba(164,214,248,.22)" />
        <circle cx="176" cy="54" r="8" fill="none" stroke="#78bdf2" stroke-width="1.5" />
        <path d="m172 54 3 3 6-6" fill="none" stroke="#78bdf2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="192" y="48" width="60" height="6" rx="3" fill="rgba(255,255,255,.16)" />
        <rect x="192" y="60" width="42" height="6" rx="3" fill="rgba(255,255,255,.09)" />
        <rect x="168" y="76" width="88" height="6" rx="3" fill="rgba(255,255,255,.07)" />

        <rect x="156" y="104" width="112" height="46" rx="10" fill={`url(#pv-fill-${kind})`} stroke="rgba(164,214,248,.16)" />
        <rect x="168" y="116" width="34" height="6" rx="3" fill="rgba(255,255,255,.14)" />
        <rect x="168" y="128" width="88" height="4" rx="2" fill="rgba(255,255,255,.07)" />
        <rect x="168" y="136" width="70" height="4" rx="2" fill="rgba(255,255,255,.07)" />
      </g>
    )
  }

  {
    kind === 'web' && (
      <g>
        <rect x="24" y="14" width="272" height="152" rx="12" fill={`url(#pv-fill-${kind})`} stroke="rgba(164,214,248,.28)" />
        <path d="M24 34h272" stroke="rgba(164,214,248,.16)" />
        <circle cx="38" cy="24" r="2.5" fill="rgba(255,255,255,.2)" />
        <circle cx="48" cy="24" r="2.5" fill="rgba(255,255,255,.14)" />
        <circle cx="58" cy="24" r="2.5" fill="rgba(255,255,255,.1)" />
        <rect x="36" y="46" width="52" height="108" rx="6" fill="rgba(255,255,255,.04)" />
        <rect x="42" y="54" width="40" height="7" rx="3" fill="rgba(120,189,242,.5)" />
        <rect x="42" y="68" width="34" height="6" rx="3" fill="rgba(255,255,255,.1)" />
        <rect x="42" y="80" width="38" height="6" rx="3" fill="rgba(255,255,255,.1)" />
        <rect x="42" y="92" width="30" height="6" rx="3" fill="rgba(255,255,255,.1)" />

        <rect x="100" y="46" width="88" height="44" rx="6" fill="rgba(255,255,255,.04)" />
        <path d="M108 78 128 66l16 8 22-16 14 10" fill="none" stroke="#78bdf2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="198" y="46" width="88" height="44" rx="6" fill="rgba(255,255,255,.04)" />
        <rect x="208" y="70" width="10" height="12" rx="2" fill="rgba(120,189,242,.7)" />
        <rect x="224" y="60" width="10" height="22" rx="2" fill="rgba(120,189,242,.5)" />
        <rect x="240" y="66" width="10" height="16" rx="2" fill="rgba(120,189,242,.6)" />
        <rect x="256" y="54" width="10" height="28" rx="2" fill="rgba(120,189,242,.4)" />

        <rect x="100" y="100" width="186" height="8" rx="3" fill="rgba(255,255,255,.1)" />
        <rect x="100" y="114" width="186" height="6" rx="3" fill="rgba(255,255,255,.06)" />
        <rect x="100" y="126" width="186" height="6" rx="3" fill="rgba(255,255,255,.06)" />
        <rect x="100" y="138" width="186" height="6" rx="3" fill="rgba(255,255,255,.06)" />
        <rect x="100" y="150" width="120" height="6" rx="3" fill="rgba(255,255,255,.06)" />
      </g>
    )
  }

  {
    kind === 'site' && (
      <g>
        <rect x="24" y="14" width="272" height="152" rx="12" fill={`url(#pv-fill-${kind})`} stroke="rgba(164,214,248,.28)" />
        <path d="M24 34h272" stroke="rgba(164,214,248,.16)" />
        <circle cx="38" cy="24" r="2.5" fill="rgba(255,255,255,.2)" />
        <circle cx="48" cy="24" r="2.5" fill="rgba(255,255,255,.14)" />
        <circle cx="58" cy="24" r="2.5" fill="rgba(255,255,255,.1)" />
        <rect x="40" y="52" width="82" height="9" rx="4" fill="rgba(255,255,255,.22)" />
        <rect x="40" y="68" width="60" height="6" rx="3" fill="rgba(255,255,255,.1)" />
        <rect x="40" y="82" width="70" height="6" rx="3" fill="rgba(255,255,255,.07)" />
        <rect x="40" y="102" width="40" height="14" rx="7" fill={`url(#pv-accent-${kind})`} />
        <rect x="86" y="102" width="40" height="14" rx="7" fill="none" stroke="rgba(164,214,248,.3)" />
        <ellipse cx="226" cy="98" rx="46" ry="14" fill="none" stroke="rgba(164,214,248,.28)" />
        <ellipse cx="226" cy="98" rx="30" ry="9" fill="none" stroke="rgba(164,214,248,.2)" stroke-dasharray="3 3" />
        <path d="M204 96c8-14 32-18 44-6-8 16-30 22-44 6z" fill="rgba(207,214,223,.55)" />
        <rect x="40" y="136" width="72" height="16" rx="5" fill="rgba(255,255,255,.05)" />
        <rect x="120" y="136" width="72" height="16" rx="5" fill="rgba(255,255,255,.05)" />
        <rect x="200" y="136" width="72" height="16" rx="5" fill="rgba(255,255,255,.05)" />
      </g>
    )
  }
</svg>

<style>
  .preview {
    width: 100%;
    height: auto;
  }
</style>
