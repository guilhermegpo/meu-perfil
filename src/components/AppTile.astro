---
import { hasPage, type Project } from '../data/projects';
import { asset } from '../lib/url';
import Icon from './Icon.astro';
import Picture from './Picture.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const image = project.heroImage!;
const titleId = `app-${project.slug}`;
---

<!--
  Vitrine 3D de um app da família Apps Meu. Mesma mecânica dos cartões de
  projeto: o invólucro não gira, o miolo inclina até 4° / 6° e cada camada tem
  profundidade própria — fundo 0, brilho 5, arte 15, rótulos 25, texto 30 e
  botões 35.
-->
<article
  class="tile"
  data-tilt
  aria-labelledby={titleId}
  style={`--pos: ${image.position ?? '50% 50%'}`}
>
  <div class="tile__tilt">
    <div class="tile__bg"></div>
    <div class="tile__glow"></div>

    <div class="tile__art">
      <Picture
        dir="projects"
        name={`${image.slug}-hero`}
        widths={[640, 1024, 1672]}
        fallback={`${image.slug}-hero-1024.webp`}
        sizes="(min-width: 72rem) 24rem, (min-width: 48rem) 40rem, 92vw"
        alt={image.alt}
        width={1672}
        height={941}
      />
      <span class="tile__caption">Imagem ilustrativa</span>
    </div>

    <div class="tile__meta">
      <span class="tile__family">{project.family}</span>
      <span class="badge" data-tone={project.tone}>{project.status}</span>
    </div>

    <div class="tile__body">
      <h3 id={titleId} class="tile__title">{project.name}</h3>
      <p class="tile__tagline">{project.tagline}</p>
    </div>

    <div class="tile__actions">
      {
        hasPage(project) && (
          <a class="btn btn--primary" href={asset(`projetos/${project.slug}`)}>
            {project.caseStudy ? 'Case study' : 'Ver página'} <Icon name="arrow" />
          </a>
        )
      }
      {
        project.links.slice(0, 1).map((link) => (
          <a class="btn" href={link.href} rel="noopener">
            {link.label} <Icon name="external" />
          </a>
        ))
      }
    </div>
  </div>
</article>

<style>
  .tile {
    position: relative;
    height: 100%;
    perspective: 1100px;
  }

  .tile__tilt {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    height: 100%;
    padding: 0.7rem 0.7rem 1.15rem;
    border-radius: var(--radius-lg);
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 520ms var(--ease);
    will-change: transform;
  }

  .tile[data-tilting='true'] .tile__tilt {
    transition: transform 90ms linear;
  }

  .tile__bg {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid var(--line);
    background: var(--glass), linear-gradient(160deg, var(--surface-2), var(--surface));
    box-shadow: var(--shadow-2);
    transition: border-color var(--dur) var(--ease);
  }

  .tile[data-tilting='true'] .tile__bg,
  .tile[data-lit='true'] .tile__bg {
    border-color: rgba(164, 214, 248, 0.32);
  }

  .tile__glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(24rem circle at var(--mx, 50%) var(--my, 30%), rgba(164, 214, 248, 0.14), transparent 55%);
    transform: translateZ(5px);
    transition: opacity var(--dur) var(--ease);
  }

  .tile[data-tilting='true'] .tile__glow,
  .tile[data-lit='true'] .tile__glow,
  .tile:focus-within .tile__glow {
    opacity: 1;
  }

  .tile__art,
  .tile__meta,
  .tile__body,
  .tile__actions {
    position: relative;
  }

  /* z = 15 */
  .tile__art {
    transform: translateZ(15px);
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.9);
    aspect-ratio: 1672 / 941;
    background: var(--bg-1);
  }

  .tile__art :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
    /* Mesmo comportamento dos cartões em destaque: zoom leve e deslocamento interno. */
    transform: translate3d(calc(var(--tx, 0) * -6px), calc(var(--ty, 0) * -4px), 0) scale(1.03);
    transition: transform 700ms var(--ease);
  }

  .tile[data-tilting='true'] .tile__art :global(img),
  .tile:focus-within .tile__art :global(img) {
    transform: translate3d(calc(var(--tx, 0) * -6px), calc(var(--ty, 0) * -4px), 0) scale(1.06);
    transition: transform 140ms linear;
  }

  .tile[data-tilting='true'] .tile__art,
  .tile:focus-within .tile__art {
    transform: translateZ(24px);
  }

  /* Reflexo suave que acompanha o cursor sobre a arte. */
  .tile__art::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(14rem circle at var(--mx, 50%) var(--my, 30%), rgba(255, 255, 255, 0.16), transparent 60%);
    transition: opacity var(--dur) var(--ease);
  }

  .tile[data-tilting='true'] .tile__art::after {
    opacity: 1;
  }

  .tile__caption {
    position: absolute;
    right: 0.55rem;
    bottom: 0.5rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: rgba(6, 9, 14, 0.72);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* z = 25 */
  .tile__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-inline: 0.5rem;
    transform: translateZ(25px);
  }

  .tile__family {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* z = 30 */
  .tile__body {
    display: grid;
    gap: 0.4rem;
    flex: 1;
    align-content: start;
    padding-inline: 0.5rem;
    transform: translateZ(30px);
  }

  .tile__title {
    font-size: var(--step-2);
  }

  .tile__tagline {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  /* z = 35 */
  .tile__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-inline: 0.5rem;
    transform: translateZ(35px);
  }

  @media (hover: none) {
    .tile__tilt {
      transform: none;
      transition: transform var(--dur) var(--ease);
    }

    .tile[data-lit='true'] .tile__tilt {
      transform: translateY(-3px);
    }

    .tile__glow {
      background: radial-gradient(24rem circle at 50% 0%, rgba(164, 214, 248, 0.13), transparent 60%);
    }

    .tile__art :global(img) {
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile__tilt,
    .tile[data-lit='true'] .tile__tilt,
    .tile__art,
    .tile__meta,
    .tile__body,
    .tile__actions,
    .tile__glow,
    .tile[data-tilting='true'] .tile__art,
    .tile:focus-within .tile__art {
      transform: none;
    }

    .tile__art :global(img),
    .tile[data-tilting='true'] .tile__art :global(img),
    .tile:focus-within .tile__art :global(img) {
      transform: none;
    }
  }

  :global(html[data-perf='lite']) .tile__tilt {
    transform: none;
  }
</style>
