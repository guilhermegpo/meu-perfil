---
import { education } from '../data/education';
import { experience } from '../data/experience';
import { asset } from '../lib/url';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="experiencia" class="section" aria-labelledby="experiencia-titulo">
  <div class="container">
    <SectionHeading
      id="experiencia-titulo"
      eyebrow="Experiência"
      title="Trajetória e formação"
      lead="Trabalho real, descrito pelo que fiz e pela tecnologia usada. Nada de detalhe interno de instituição."
    />

    <ol class="timeline">
      {
        experience.map((entry, index) => (
          <li class="entry" data-reveal data-reveal-delay={String(index * 80)}>
            <div class="entry__meta">
              <p class="entry__period">{entry.period}</p>
              <p class="entry__place">{entry.location}</p>
            </div>

            <div class="entry__body glass">
              <h3 class="entry__org">{entry.organization}</h3>
              <p class="entry__role">
                {entry.role}
                {entry.focus && <span> · {entry.focus}</span>}
              </p>
              <p class="entry__summary">{entry.summary}</p>

              <ul class="entry__list">
                {entry.achievements.map((item) => <li>{item}</li>)}
              </ul>

              {entry.stack && (
                <ul class="entry__stack" aria-label="Tecnologias">
                  {entry.stack.map((tech) => (
                    <li class="chip">{tech}</li>
                  ))}
                </ul>
              )}

              {entry.caseStudy && (
                <a class="entry__case" href={asset(`projetos/${entry.caseStudy}`)}>
                  Ver o case <Icon name="arrow" />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="education" data-reveal>
      <h3 class="education__title">Formação</h3>
      <ul class="education__list">
        {
          education.map((item) => (
            <li class="education__item">
              <p class="education__name">{item.title}</p>
              <p class="education__meta">
                {[item.institution, item.period ?? item.status].filter(Boolean).join(' · ')}
              </p>
              {item.note && <p class="education__note">{item.note}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .timeline {
    display: grid;
    gap: var(--space-md);
  }

  .entry {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 56rem) {
    .entry {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--space-md);
    }
  }

  .entry__meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .entry__period {
    color: var(--accent);
  }

  .entry__place {
    color: var(--text-faint);
  }

  .entry__body {
    display: grid;
    gap: var(--space-xs);
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
  }

  .entry__org {
    font-size: var(--step-2);
  }

  .entry__role {
    color: var(--text-muted);
    font-weight: 500;
  }

  .entry__summary {
    max-width: 66ch;
    color: var(--text-muted);
  }

  .entry__list {
    display: grid;
    gap: 0.4rem;
    max-width: 66ch;
    margin-top: 0.25rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .entry__list li {
    position: relative;
    padding-left: 1.1rem;
  }

  .entry__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.4rem;
    height: 1px;
    background: var(--accent);
  }

  .entry__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .entry__case {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    min-height: 2.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  .education {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .education__title {
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .education__list {
    display: grid;
    gap: var(--space-sm);
  }

  @media (min-width: 56rem) {
    .education__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-md);
    }
  }

  .education__name {
    font-weight: 600;
  }

  .education__meta {
    margin-top: 0.15rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .education__note {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>
