---
import { evidence } from '../data/evidence';
import { projects } from '../data/projects';
import { projectCountLabel, stackGroups } from '../data/stack';
import SectionHeading from './SectionHeading.astro';

const total = evidence.metrics.projectsAnalyzed;
const projectName = (id: string): string => projects.find((p) => p.slug === id)?.name ?? id;
---

<section id="stack" class="section" aria-labelledby="stack-titulo">
  <div class="container">
    <SectionHeading
      id="stack-titulo"
      eyebrow="Stack"
      title="Tecnologias que usei de fato"
      lead={`Cada item foi detectado nos ${total} repositórios analisados, e o número é a quantidade de projetos em que aparece. Sem percentuais de habilidade.`}
    />

    <div class="groups">
      {
        stackGroups.map((group, index) => (
          <section class="group glass" data-reveal data-reveal-delay={String(index * 60)}>
            <h3 class="group__title">{group.title}</h3>
            <ul class="group__list">
              {group.items.map((tech) => (
                <li class="tech">
                  <span class="tech__name">{tech.name}</span>
                  <span class="tech__count">{projectCountLabel(tech.count)}</span>
                  <span class="tech__pips" aria-hidden="true">
                    {Array.from({ length: total }, (_, i) => (
                      <i class:list={{ on: i < tech.count }} />
                    ))}
                  </span>
                  <span class="sr-only">: {tech.projects.map(projectName).join(', ')}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="source" data-reveal>
      Levantamento de {evidence.generatedAt}, gerado por script a partir dos repositórios. Veja como
      em <code>docs/CONTENT_SOURCE.md</code>. Ferramentas de desenvolvimento assistido por IA fazem
      parte do meu fluxo, ao lado de Git, testes e CI.
    </p>
  </div>
</section>

<style>
  .groups {
    display: grid;
    gap: var(--space-sm);
  }

  @media (min-width: 40rem) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .group {
    padding: 1.25rem 1.35rem 1.4rem;
    border-radius: var(--radius);
  }

  .group__title {
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .group__list {
    display: grid;
  }

  .tech {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.1rem 0.75rem;
    padding-block: 0.6rem;
    border-top: 1px solid var(--line);
  }

  .tech:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .tech__name {
    font-weight: 600;
  }

  .tech__count {
    grid-column: 1;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .tech__pips {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: inline-flex;
    gap: 3px;
  }

  .tech__pips i {
    width: 0.4rem;
    height: 0.9rem;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.08);
  }

  .tech__pips i.on {
    background: linear-gradient(180deg, var(--accent-strong), var(--accent-deep));
  }

  .source {
    margin-top: var(--space-md);
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .source code {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }
</style>
