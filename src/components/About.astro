---
import SectionHeading from './SectionHeading.astro';

const facts = [
  {
    eyebrow: 'Formação',
    title: 'ADS concluído',
    body: 'Universidade Cruzeiro do Sul',
    size: 'wide',
  },
  {
    eyebrow: 'Atuação',
    title: 'Full Stack',
    body: 'Interface, backend e dados',
    size: 'regular',
  },
  {
    eyebrow: 'Foco',
    title: 'Mobile & Backend',
    body: 'Direção profissional',
    size: 'regular',
  },
  {
    eyebrow: 'Experiência real',
    title: 'Projeto implantado',
    body: 'Aplicação web interna no ILA/FAB',
    size: 'wide',
  },
] as const;

const pillars = [
  {
    title: 'Entender antes de codar',
    body: 'No ILA, o trabalho começou conversando com quem usaria o sistema e mapeando o fluxo que já existia. Requisito mal entendido custa mais caro que qualquer bug.',
  },
  {
    title: 'Decisão documentada',
    body: 'Escolhas de arquitetura relevantes viram registro escrito — contexto, alternativas e consequências. Se eu não consigo explicar uma decisão, ela não entra no projeto.',
  },
  {
    title: 'Entregar e sustentar',
    body: 'Implantar não é o fim. Suporte ao usuário e documentação fazem parte da entrega, e são o que decide se o sistema continua vivo depois que você sai.',
  },
];
---

<section class="section about" id="sobre">
  <div class="container">
    <SectionHeading
      eyebrow="Sobre"
      title="Produto, engenharia e contexto"
      lead="Formado em Análise e Desenvolvimento de Sistemas, com experiência prática construindo uma solução que entrou em uso real. Meu interesse está em produtos completos — do modelo de dados à interface — com atenção especial a desenvolvimento web e mobile."
    />

    <ul class="bento" aria-label="Resumo profissional">
      {
        facts.map((fact, index) => (
          <li
            class="fact"
            data-size={fact.size}
            data-reveal
            data-reveal-delay={index * 60}
          >
            <p class="fact__eyebrow">{fact.eyebrow}</p>
            <h3 class="fact__title">{fact.title}</h3>
            <p class="fact__body">{fact.body}</p>
          </li>
        ))
      }

      {
        pillars.map((pillar, index) => (
          <li class="pillar" data-reveal data-reveal-delay={(index + facts.length) * 60}>
            <span class="pillar__index" aria-hidden="true">0{index + 1}</span>
            <h3 class="pillar__title">{pillar.title}</h3>
            <p class="pillar__body">{pillar.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    position: relative;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0;
  }

  .fact,
  .pillar {
    position: relative;
    min-width: 0;
    overflow: hidden;
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    transition: border-color var(--motion-normal) var(--ease-standard),
      transform var(--motion-normal) var(--ease-emphasized),
      box-shadow var(--motion-normal) var(--ease-standard);
  }

  .fact::after {
    content: '';
    position: absolute;
    right: -2.5rem;
    bottom: -3.5rem;
    width: 9rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 50%;
    box-shadow: 0 0 0 1.5rem color-mix(in srgb, var(--accent) 5%, transparent),
      0 0 0 3rem color-mix(in srgb, var(--accent) 4%, transparent);
    pointer-events: none;
  }

  .fact:hover,
  .pillar:hover {
    border-color: color-mix(in srgb, var(--accent) 70%, var(--border));
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .fact__eyebrow,
  .pillar__index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .fact__title {
    margin-top: var(--space-sm);
    max-width: 14ch;
    font-size: var(--step-3);
  }

  .fact__body {
    margin-top: var(--space-xs);
    max-width: 30ch;
    color: var(--text-muted);
  }

  .pillar {
    display: grid;
    align-content: start;
  }

  .pillar__title {
    margin-top: var(--space-sm);
    font-size: var(--step-1);
  }

  .pillar__body {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  @media (min-width: 58rem) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .fact {
      grid-column: span 5;
      min-height: 15rem;
    }

    .fact[data-size='wide'] {
      grid-column: span 7;
    }

    .pillar {
      grid-column: span 4;
      min-height: 15rem;
    }
  }

  @media (max-width: 38rem) {
    .bento {
      grid-template-columns: 1fr;
    }

    .fact,
    .pillar {
      padding: var(--space-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fact:hover,
    .pillar:hover {
      transform: none;
    }
  }
</style>
