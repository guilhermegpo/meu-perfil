---
import { profile } from '../data/profile';

const principles = [
  {
    title: 'Decisão documentada',
    body: 'Escolhas de arquitetura relevantes viram ADRs — contexto, alternativas e consequências. Se não consigo explicar uma decisão, ela não entra no projeto.',
  },
  {
    title: 'Simples antes de esperto',
    body: 'Prefiro código legível a abstração prematura. Camada só existe quando resolve um problema concreto, não para antecipar um que talvez nunca apareça.',
  },
  {
    title: 'Privacidade por padrão',
    body: 'Dado sensível não entra em repositório público. Projetos com dados de pessoas usam fixtures e seeds fictícios desde o primeiro commit.',
  },
];
---

<section class="section" id="sobre">
  <div class="container">
    <div class="section__header">
      <span class="eyebrow">Sobre</span>
      <h2 class="section__title">Como eu trabalho</h2>
      <p class="section__lead">{profile.summary}</p>
    </div>

    <ul class="principles">
      {
        principles.map((item) => (
          <li class="principle">
            <h3 class="principle__title">{item.title}</h3>
            <p class="principle__body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-md);
    margin: 0;
  }

  .principle {
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
  }

  .principle__title {
    font-size: var(--step-0);
    font-weight: 600;
  }

  .principle__body {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>
