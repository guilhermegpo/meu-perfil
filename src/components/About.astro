---
import { Image } from 'astro:assets';
import portrait from '../assets/guilherme.png';
import { profile } from '../data/profile';
import SectionHeading from './SectionHeading.astro';

/**
 * Cada ficha abaixo aponta para algo que existe nos projetos. O texto do
 * lado esquerdo é curto de propósito: as evidências estão nas outras seções.
 */
const facts = [
  {
    label: 'Formação',
    value: 'Graduado em ADS',
    note: 'Análise e Desenvolvimento de Sistemas, Universidade Cruzeiro do Sul · concluído em 2026',
  },
  {
    label: 'Atuação',
    value: 'Web, Mobile e Backend',
    note: 'Cada frente tem um projeto que a comprova',
  },
  {
    label: 'Produto real',
    value: 'Sistemas em uso',
    note: 'Aplicação institucional implantada e app operacional em uso por uma equipe',
  },
  {
    label: 'Método',
    value: 'Do requisito ao release',
    note: 'Modelo de dados, regras no banco, interface, testes e versionamento',
  },
];
---

<section id="sobre" class="section" aria-labelledby="sobre-titulo">
  <div class="container">
    <SectionHeading id="sobre-titulo" eyebrow="Sobre" title="Engenharia voltada ao uso real" />

    <div class="about">
      <div class="about__text" data-reveal>
        <p>
          Trabalho do requisito ao uso: converso com quem opera o sistema, modelo os dados, coloco
          as regras críticas onde elas não podem ser contornadas e só então cuido da interface.
        </p>
        <p>
          Implantei uma aplicação web interna em uma instituição e mantenho projetos próprios em
          que segurança, testes, versionamento e documentação fazem parte do produto — não do que
          sobra no fim.
        </p>
        <p class="about__note">
          Uso assistentes de IA no desenvolvimento (Claude e Lovable, como o histórico dos
          repositórios mostra). Requisitos, revisão, validação e decisões de arquitetura ficam
          comigo.
        </p>
      </div>

      <figure class="portrait" data-reveal data-reveal-delay="80">
        <div class="portrait__frame">
          <Image
            src={portrait}
            width={320}
            height={320}
            densities={[1, 2]}
            format="webp"
            alt={`Retrato de ${profile.name}`}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>{profile.location}</figcaption>
      </figure>

      <ul class="facts">
        {
          facts.map((fact, index) => (
            <li class="fact glass" data-reveal data-reveal-delay={String(index * 70)}>
              <p class="fact__label">{fact.label}</p>
              <p class="fact__value">{fact.value}</p>
              <p class="fact__note">{fact.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  @media (min-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: start;
    }

    .facts {
      grid-column: 1 / -1;
    }
  }

  .about__text {
    display: grid;
    gap: var(--space-sm);
    max-width: 62ch;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .about__text p:first-child {
    color: var(--text);
  }

  .about__note {
    padding-left: var(--space-sm);
    border-left: 2px solid var(--line-strong);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--text-faint);
  }

  .portrait {
    justify-self: start;
    margin: 0;
  }

  @media (min-width: 56rem) {
    .portrait {
      justify-self: end;
    }
  }

  .portrait__frame {
    width: fit-content;
    padding: 0.4rem;
    border-radius: 1.4rem;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.04) 40%, rgba(164, 214, 248, 0.2));
    box-shadow: var(--shadow-2);
  }

  .portrait__frame :global(img) {
    width: min(100%, 15rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 1.1rem;
    filter: saturate(0.85) contrast(1.04);
  }

  .portrait figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .facts {
    display: grid;
    gap: var(--space-sm);
  }

  @media (min-width: 40rem) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .fact {
    display: grid;
    gap: 0.35rem;
    padding: var(--space-sm) 1.15rem 1.15rem;
    border-radius: var(--radius);
  }

  .fact__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .fact__value {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.2;
  }

  .fact__note {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
</style>
