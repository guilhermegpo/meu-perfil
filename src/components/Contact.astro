---
import SectionHeading from './SectionHeading.astro';
import { profile } from '../data/profile';
import { resumeAvailable, resumeHref } from '../lib/resume';

const channels = [
  {
    label: 'LinkedIn',
    handle: 'guilhermeoliveira-gpo',
    href: profile.links.linkedin,
    note: 'Melhor canal para oportunidades e conversas profissionais.',
  },
  {
    label: 'E-mail',
    handle: profile.email,
    href: `mailto:${profile.email}`,
    note: 'Para propostas, dúvidas ou envio de descrição de vaga.',
  },
  {
    label: 'GitHub',
    handle: '@guilhermegpo',
    href: profile.links.github,
    note: 'Código, histórico de commits e documentação dos projetos.',
  },
];
---

<section class="section" id="contato">
  <div class="container">
    <SectionHeading
      eyebrow="Contato"
      title="Vamos construir algo que funcione de verdade"
      lead="Aberto a oportunidades como desenvolvedor Full Stack, Mobile ou Backend. Se o que você viu aqui conversa com o que seu time precisa, o caminho mais rápido é o LinkedIn."
    />

    <ul class="channels">
      {
        channels.map((channel, index) => (
          <li class="channel" data-reveal data-reveal-delay={index * 70}>
            <a class="channel__link" href={channel.href} rel="noopener">
              <span class="channel__label">{channel.label}</span>
              <span class="channel__handle">{channel.handle}</span>
            </a>
            <p class="channel__note">{channel.note}</p>
          </li>
        ))
      }
    </ul>

    {
      resumeAvailable && (
        <p class="resume" data-reveal>
          <a class="button button--primary" href={resumeHref} download>
            Baixar currículo
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14" />
            </svg>
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-sm);
    margin: 0;
  }

  .channel {
    position: relative;
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .channel:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .channel__link {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-decoration: none;
  }

  .channel__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .channel__label {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--text);
  }

  .channel__handle {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
    overflow-wrap: anywhere;
  }

  .channel__note {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .resume {
    margin-top: var(--space-md);
  }

  .resume svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: reduce) {
    .channel:hover {
      transform: none;
    }
  }
</style>
