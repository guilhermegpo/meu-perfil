---
import { profile } from '../data/profile';
import { resumeAvailable, resumeHref } from '../lib/resume';
import Icon from './Icon.astro';

const mailto = `mailto:${profile.email}?subject=${encodeURIComponent('Contato pelo portfólio')}`;
---

<section id="contato" class="section" aria-labelledby="contato-titulo">
  <div class="container">
    <div class="cta glass" data-reveal>
      <div class="cta__copy">
        <p class="eyebrow">Contato</p>
        <h2 id="contato-titulo" class="cta__title">Vamos construir algo?</h2>
        <p class="cta__lead">
          Estou aberto a oportunidades como desenvolvedor Full Stack. Se o problema é real, quero
          entender o contexto antes de propor qualquer solução.
        </p>
      </div>

      <div class="cta__actions">
        <a class="btn btn--primary" href={mailto}>
          <Icon name="mail" /> {profile.email}
        </a>
        <a class="btn" href={profile.links.linkedin} rel="noopener">
          <Icon name="linkedin" /> LinkedIn
        </a>
        <a class="btn" href={profile.links.github} rel="noopener">
          <Icon name="github" /> GitHub
        </a>
        {
          resumeAvailable && (
            <a class="btn" href={resumeHref} download>
              <Icon name="download" /> Currículo
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    display: grid;
    gap: var(--space-md);
    padding: clamp(1.75rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-2);
  }

  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(40rem 20rem at 100% 0%, rgba(120, 189, 242, 0.14), transparent 60%);
  }

  @media (min-width: 60rem) {
    .cta {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  .cta__copy,
  .cta__actions {
    position: relative;
  }

  .cta__title {
    margin-top: var(--space-xs);
    font-size: var(--step-4);
  }

  .cta__lead {
    max-width: 48ch;
    margin-top: var(--space-sm);
    color: var(--text-muted);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 60rem) {
    .cta__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .cta__actions .btn {
    justify-content: flex-start;
    overflow-wrap: anywhere;
  }
</style>
