---
import { asset } from '../lib/url';
import { projectSignals, projectStack, type Project } from '../data/projects';
import Icon from './Icon.astro';
import ProjectPreview from './ProjectPreview.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const stack = projectStack(project.slug).slice(0, 6);
const signals = projectSignals(project.slug);
const titleId = `card-${project.slug}`;
const kindIcon = { mobile: 'phone', web: 'window', site: 'globe' } as const;
---

<!--
  Cartão 3D. O invólucro externo (`.card`) nunca gira — ele só fornece a
  perspectiva e o retângulo estável para medir o cursor. O que gira é
  `.card__tilt`, no máximo 4° em X e 6° em Y, e cada camada interna recebe
  uma profundidade própria (translateZ) para o efeito de paralaxe:

    fundo 0 · brilho 5 · ilustração 15 · rótulo 25 · título 30 · botões 35
-->
<article class="card" data-tilt aria-labelledby={titleId}>
  <div class="card__tilt">
    <div class="card__bg"></div>
    <div class="card__glow"></div>

    <div class="card__preview">
      <ProjectPreview kind={project.kind} />
      <span class="card__caption">Ilustração</span>
    </div>

    <div class="card__label">
      <span class="card__kind"><Icon name={kindIcon[project.kind]} /> {project.category}</span>
      <span class="badge" data-tone={project.tone}>{project.status}</span>
    </div>

    <div class="card__content">
      <h3 id={titleId} class="card__title">{project.name}</h3>
      <p class="card__tagline">{project.tagline}</p>

      <ul class="card__highlights">
        {project.highlights.map((item) => <li>{item}</li>)}
      </ul>

      <ul class="card__stack" aria-label="Tecnologias">
        {stack.map((tech) => <li class="chip">{tech}</li>)}
      </ul>

      {
        signals.length > 0 && (
          <p class="card__signals">{signals.join(' · ')}</p>
        )
      }

      {project.disclosure && <p class="card__disclosure">Código e telas não públicos</p>}
    </div>

    <div class="card__actions">
      {
        project.caseStudy && (
          <a class="btn btn--primary" href={asset(`projetos/${project.slug}`)}>
            Case study <Icon name="arrow" />
          </a>
        )
      }
      {
        project.links.slice(0, 1).map((link) => (
          <a class="btn" href={link.href} rel="noopener">
            {link.label} <Icon name="external" />
          </a>
        ))
      }
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    height: 100%;
    perspective: 1100px;
  }

  .card__tilt {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    height: 100%;
    padding: 1.1rem 1.1rem 1.25rem;
    border-radius: var(--radius-lg);
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 520ms var(--ease);
    will-change: transform;
  }

  .card[data-tilting='true'] .card__tilt {
    transition: transform 90ms linear;
  }

  /* z = 0: fundo de vidro escuro com borda de luz. */
  .card__bg {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid var(--line);
    background: var(--glass), linear-gradient(160deg, var(--surface-2), var(--surface));
    box-shadow: var(--shadow-2);
    transform: translateZ(0);
  }

  /* z = 5: brilho especular que segue o cursor. */
  .card__glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      26rem circle at var(--mx, 50%) var(--my, 30%),
      rgba(164, 214, 248, 0.16),
      transparent 55%
    );
    transform: translateZ(5px);
    transition: opacity var(--dur) var(--ease);
  }

  .card[data-tilting='true'] .card__glow,
  .card[data-lit='true'] .card__glow,
  .card:focus-within .card__glow {
    opacity: 1;
  }

  .card__preview,
  .card__label,
  .card__content,
  .card__actions {
    position: relative;
  }

  /* z = 15 */
  .card__preview {
    transform: translateZ(15px);
    padding: 0.6rem;
    border-radius: var(--radius);
    background: radial-gradient(120% 90% at 50% 0%, rgba(120, 189, 242, 0.1), transparent 70%), var(--bg-1);
    border: 1px solid var(--line);
  }

  .card__caption {
    position: absolute;
    right: 0.7rem;
    bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* z = 25 */
  .card__label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    transform: translateZ(25px);
  }

  .card__kind {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* z = 30 */
  .card__content {
    display: grid;
    gap: 0.7rem;
    flex: 1;
    align-content: start;
    transform: translateZ(30px);
  }

  .card__title {
    font-size: var(--step-2);
  }

  .card__tagline {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .card__highlights {
    display: grid;
    gap: 0.3rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .card__highlights li {
    position: relative;
    padding-left: 1.1rem;
  }

  .card__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 1px;
    background: var(--accent);
  }

  .card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .card__signals {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: var(--text-faint);
  }

  .card__disclosure {
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  /* z = 35 */
  .card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    transform: translateZ(35px);
  }

  /* Toque: sem hover, o cartão no centro da tela sobe um pouco e ganha luz. */
  @media (hover: none) {
    .card__tilt {
      transform: none;
      transition: transform var(--dur) var(--ease);
    }

    .card[data-lit='true'] .card__tilt {
      transform: translateY(-3px);
    }

    .card__glow {
      background: radial-gradient(26rem circle at 50% 0%, rgba(164, 214, 248, 0.14), transparent 60%);
    }

    .card__tilt:active {
      transform: scale(0.99);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__tilt,
    .card[data-lit='true'] .card__tilt {
      transform: none;
    }

    .card__preview,
    .card__label,
    .card__content,
    .card__actions,
    .card__glow,
    .card__bg {
      transform: none;
    }
  }

  :global(html[data-perf='lite']) .card__tilt {
    transform: none;
  }
</style>
