---
import type { Project } from '../data/projects';
import { asset } from '../lib/url';

interface Props {
  project: Project;
  featured?: boolean;
  order?: number;
}

const { project, featured = false, order } = Astro.props;
const caseHref = asset(`projetos/${project.slug}/`);
---

<article class:list={['card', featured && 'card--featured']}>
  {order && <p class="card__index" aria-hidden="true">Case / {String(order).padStart(2, '0')}</p>}

  <header class="card__head">
    <p class="card__category">{project.category}</p>
    <p class="card__status" data-status={project.status}>
      <span class="card__dot" aria-hidden="true"></span>
      {project.status}
    </p>
  </header>

  <h3 class="card__title">
    <a class="card__link" href={caseHref}>{project.name}</a>
  </h3>

  <p class="card__tagline">{project.tagline}</p>

  {
    featured && (
      <dl class="card__case">
        <div>
          <dt>Problema</dt>
          <dd>{project.problem}</dd>
        </div>
        <div>
          <dt>Resultado</dt>
          <dd>{project.result}</dd>
        </div>
      </dl>
    )
  }

  <ul class="card__stack">
    {project.stack.map((tech) => <li>{tech}</li>)}
  </ul>

  <footer class="card__footer">
    <a class="card__cta" href={caseHref}>
      Ver o case
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m0 0-5-5m5 5-5 5" /></svg>
    </a>
    {
      project.links.map((link) => (
        <a class="card__secondary" href={link.href} rel="noopener">
          {link.label}
        </a>
      ))
    }
  </footer>
</article>

<style>
  .card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: linear-gradient(
        135deg,
        color-mix(in srgb, var(--accent-subtle) 42%, transparent),
        transparent 34%
      ),
      var(--bg-elevated);
    transition: border-color var(--motion-normal) var(--ease-standard),
      transform var(--motion-normal) var(--ease-emphasized),
      box-shadow var(--motion-normal) var(--ease-standard);
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4rem;
    height: 2px;
    background: var(--accent);
  }

  .card__index {
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* Toda a área do card leva ao case; os links do rodapé ficam acima dele. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card__link {
    color: inherit;
    text-decoration: none;
  }

  .card:hover .card__link {
    color: var(--accent);
  }

  .card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem var(--space-sm);
  }

  .card__category {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.1rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--bg-subtle);
    font-size: var(--step--1);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .card__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-faint);
  }

  .card__status[data-status='implantado'] {
    background: var(--accent-subtle);
    color: var(--accent);
  }

  .card__status[data-status='implantado'] .card__dot {
    background: currentColor;
  }

  .card__title {
    overflow-wrap: break-word;
    margin-top: var(--space-sm);
    font-size: var(--step-2);
  }

  .card--featured .card__title {
    font-size: var(--step-3);
  }

  .card__tagline {
    margin-top: var(--space-xs);
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .card__case {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }

  .card__case dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card__case dd {
    margin: 0.25rem 0 0;
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: var(--space-md);
  }

  .card__stack li {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-md);
  }

  .card__cta,
  .card__secondary {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--step--1);
    font-weight: 550;
    text-decoration: none;
  }

  .card__secondary {
    color: var(--text-muted);
  }

  .card__secondary:hover {
    color: var(--accent);
  }

  .card__cta svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.25s var(--ease);
  }

  .card:hover .card__cta svg {
    transform: translateX(3px);
  }

  @media (max-width: 26rem) {
    .card {
      padding: var(--space-sm);
    }
  }

  @media (min-width: 56rem) {
    .card--featured {
      padding: var(--space-lg);
    }

    .card--featured .card__case {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }

    .card:hover .card__cta svg {
      transform: none;
    }
  }
</style>
