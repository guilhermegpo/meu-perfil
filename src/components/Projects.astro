---
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
import { featuredProjects, otherProjects } from '../data/projects';
---

<section class="section" id="projetos">
  <div class="container">
    <SectionHeading
      eyebrow="Projetos"
      title="Cases"
      lead="Cada projeto responde quatro perguntas: qual era o problema, o que eu fiz, como foi resolvido e o que mudou depois. Clique para ver o case completo."
    />

    <div class="featured">
      {
        featuredProjects.map((project, index) => (
          <div
            class="featured__item"
            style={`--sticky-top: ${5.5 + index * 0.75}rem`}
            data-reveal
            data-reveal-delay={index * 90}
          >
            <ProjectCard project={project} featured order={index + 1} />
          </div>
        ))
      }
    </div>

    {
      otherProjects.length > 0 && (
        <>
          <h3 class="more">Outros projetos</h3>
          <div class="grid">
            {otherProjects.map((project, index) => (
              <div data-reveal data-reveal-delay={index * 80}>
                <ProjectCard project={project} order={featuredProjects.length + index + 1} />
              </div>
            ))}
          </div>
        </>
      )
    }
  </div>
</section>

<style>
  .featured {
    display: grid;
    gap: var(--space-md);
  }

  .featured__item {
    isolation: isolate;
  }

  .featured > *,
  .grid > * {
    height: 100%;
    /* Sem isto, um card largo estica a faixa do grid além da viewport. */
    min-width: 0;
  }

  .more {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-md);
  }

  @media (min-width: 64rem) {
    .featured {
      gap: var(--space-xl);
    }

    .featured__item {
      position: sticky;
      top: var(--sticky-top);
    }
  }
</style>
