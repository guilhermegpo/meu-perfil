---
import { featuredProjects, projects, projectStack } from '../data/projects';
import { asset } from '../lib/url';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="projetos" class="section" aria-labelledby="projetos-titulo">
  <div class="container">
    <SectionHeading
      id="projetos-titulo"
      eyebrow="Projetos"
      title="O que construí"
      lead="Três projetos em destaque, com case completo: problema, decisões, desafios e o que aprendi. Sistemas privados aparecem de forma genérica — sem telas, dados ou nomes."
    />

    <h3 class="group-title" data-reveal>Em destaque</h3>
    <ul class="featured">
      {
        featuredProjects.map((project, index) => (
          <li data-reveal data-reveal-delay={String(index * 90)}>
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>

    <h3 class="group-title group-title--all" data-reveal>Todos os projetos</h3>
    <ul class="all" data-reveal>
      {
        projects.map((project) => (
          <li class="row">
            <div class="row__main">
              <p class="row__name">{project.name}</p>
              <p class="row__category">{project.category}</p>
            </div>
            <span class="badge row__status" data-tone={project.tone}>
              {project.status}
            </span>
            <p class="row__stack">{projectStack(project.slug).slice(0, 4).join(' · ')}</p>
            <div class="row__links">
              {project.caseStudy ? (
                <a class="row__link" href={asset(`projetos/${project.slug}`)}>
                  Case study <Icon name="arrow" />
                </a>
              ) : (
                <span class="row__note">Sem página pública</span>
              )}
              {project.repository && (
                <a class="row__link" href={project.repository} rel="noopener">
                  GitHub <Icon name="external" />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .group-title {
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .group-title--all {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .featured {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 48rem) {
    .featured {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .featured {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .all {
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    gap: 0.4rem 1rem;
    align-items: center;
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 60rem) {
    .row {
      grid-template-columns: minmax(0, 1.5fr) 14rem minmax(0, 1.5fr) minmax(0, 1fr);
      gap: var(--space-md);
    }
  }

  .row__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .row__category,
  .row__stack,
  .row__note {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .row__status {
    justify-self: start;
  }

  .row__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  @media (min-width: 60rem) {
    .row__links {
      justify-content: flex-end;
    }
  }

  .row__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
</style>
