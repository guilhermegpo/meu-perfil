---
import { profile } from '../data/profile';
import { resumeAvailable, resumeHref } from '../lib/resume';
import HeroScene from './HeroScene.astro';
import Icon from './Icon.astro';

const socials = [
  { label: 'GitHub', href: profile.links.github, icon: 'github' as const },
  { label: 'LinkedIn', href: profile.links.linkedin, icon: 'linkedin' as const },
  { label: 'E-mail', href: `mailto:${profile.email}`, icon: 'mail' as const },
];
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="status glass" data-reveal>
        <span class="status__dot" aria-hidden="true"></span>
        {profile.status}
        <span class="status__place">· {profile.location}</span>
      </p>

      <h1 id="hero-title" class="name" data-reveal data-reveal-delay="60">
        <span class="name__first">{profile.firstName}</span>
        <span class="name__rest">Pereira de Oliveira</span>
      </h1>

      <p class="role" data-reveal data-reveal-delay="120">
        <span class="role__title">{profile.role}</span>
        <span class="role__areas">
          {profile.areas.map((area) => <span class="chip">{area}</span>)}
        </span>
      </p>

      <p class="headline" data-reveal data-reveal-delay="180">{profile.headline}</p>
      <p class="description" data-reveal data-reveal-delay="220">{profile.description}</p>

      <div class="actions" data-reveal data-reveal-delay="280">
        <a class="btn btn--primary" href="#projetos">
          Ver projetos <Icon name="arrow" />
        </a>
        <a class="btn" href="#contato">Falar comigo</a>
        {
          resumeAvailable && (
            <a class="btn" href={resumeHref} download>
              <Icon name="download" /> Currículo
            </a>
          )
        }
      </div>

      <ul class="socials" aria-label="Redes e contato" data-reveal data-reveal-delay="320">
        {
          socials.map((social) => (
            <li>
              <a
                class="socials__link"
                href={social.href}
                aria-label={social.label}
                rel={social.href.startsWith('http') ? 'noopener' : undefined}
              >
                <Icon name={social.icon} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__scene" data-reveal data-reveal-delay="140">
      <HeroScene />
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: min(100svh, 62rem);
    padding-top: calc(var(--header-h) + clamp(1.5rem, 5vw, 4rem));
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    }
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-sm);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--text);
  }

  .status__place {
    color: var(--text-muted);
  }

  .status__dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--tone-live);
  }

  .status__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--tone-live);
    animation: ping 2.6s ease-out infinite;
  }

  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    80%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  .name {
    display: grid;
    gap: 0.15em;
    margin-top: var(--space-2xs);
  }

  .name__first {
    font-size: var(--step-hero);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    background: linear-gradient(180deg, #ffffff 15%, #aebbc9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .name__rest {
    font-size: clamp(1.35rem, 0.85rem + 2.6vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--text-muted);
  }

  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
  }

  .role__title {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .role__areas {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .headline {
    max-width: 30ch;
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .description {
    max-width: 54ch;
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-xs);
  }

  .socials {
    display: flex;
    gap: 0.5rem;
  }

  .socials__link {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    color: var(--text-muted);
    font-size: 1.15rem;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .socials__link:hover {
    color: var(--text);
    border-color: var(--line-strong);
    background: rgba(255, 255, 255, 0.05);
  }

  /* No celular a cena vem depois do texto e não empurra os botões para baixo. */
  @media (max-width: 63.99rem) {
    .hero {
      min-height: 0;
    }

    .hero__scene {
      order: 2;
    }
  }
</style>
