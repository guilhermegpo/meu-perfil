---
import { Picture } from 'astro:assets';
import photo from '../assets/guilherme.png';
import { profile } from '../data/profile';
import { resumeAvailable, resumeHref } from '../lib/resume';
---

<section class="hero" id="inicio">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__location">{profile.location}</p>

      <h1 class="hero__name">{profile.displayName}</h1>

      <p class="hero__role">
        {profile.role}
        <span class="hero__focus">{profile.focus}</span>
      </p>

      <p class="hero__headline">{profile.headline}</p>

      <div class="hero__actions">
        <a class="button button--primary" href="#projetos">Ver projetos</a>

        {
          resumeAvailable && (
            <a class="button button--outline" href={resumeHref} download>
              Baixar currículo
              <svg viewBox="0 0 24 24" aria-hidden="true" class="icon">
                <path d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14" />
              </svg>
            </a>
          )
        }

        <a class="button button--outline" href={profile.links.github} rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="icon icon--solid">
            <path
              d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.72c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.570 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
            />
          </svg>
          GitHub
        </a>

        <a class="button button--outline" href={profile.links.linkedin} rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="icon icon--solid">
            <path
              d="M6.94 5.5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.4 8.9h3.1V21H3.4V8.9Zm5.5 0h2.97v1.65h.04c.41-.78 1.42-1.6 2.93-1.6 3.13 0 3.71 2.06 3.71 4.74V21h-3.09v-5.68c0-1.35-.02-3.1-1.89-3.1-1.89 0-2.18 1.48-2.18 3v5.78H8.9V8.9Z"
            />
          </svg>
          LinkedIn
        </a>
      </div>
    </div>

    <div class="hero__portrait">
      <Picture
        src={photo}
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        quality={78}
        widths={[220, 320, 440, 560]}
        sizes="(max-width: 48rem) 7.5rem, 17rem"
        alt={`Retrato de ${profile.name}`}
        loading="eager"
        fetchpriority="high"
        class="hero__photo"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-xl) var(--space-lg);
    overflow: hidden;
  }

  /* Halo discreto atrás do conteúdo — único uso de gradiente no site. */
  .hero::before {
    content: '';
    position: absolute;
    top: -30%;
    left: 50%;
    width: min(70rem, 130%);
    aspect-ratio: 2 / 1;
    translate: -50% 0;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--accent) 12%, transparent),
      transparent 65%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(2rem, 6vw, 4.5rem);
  }

  .hero__content {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hero__location {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .hero__name {
    margin-top: var(--space-xs);
    font-size: var(--step-5);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .hero__role {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--text-muted);
  }

  .hero__focus {
    display: block;
    color: var(--accent);
  }

  .hero__headline {
    margin-top: var(--space-md);
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: var(--space-md);
  }

  .icon {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon--solid {
    fill: currentColor;
    stroke: none;
  }

  .hero__portrait {
    flex: 0 0 auto;
  }

  .hero__photo {
    width: 17rem;
    height: 17rem;
    border-radius: var(--radius-lg);
    object-fit: cover;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  @media (max-width: 48rem) {
    .hero {
      padding-block: var(--space-lg) var(--space-md);
    }

    /* Empilhado e alinhado à esquerda: a foto isolada à direita deixava um
       vazio grande ao lado dela. */
    .hero__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .hero__content {
      order: 2;
      width: 100%;
    }

    .hero__portrait {
      order: 1;
    }

    .hero__photo {
      width: 7.5rem;
      height: 7.5rem;
      border-radius: var(--radius-md);
    }

    .hero__actions .button {
      flex: 1 1 auto;
    }
  }
</style>
