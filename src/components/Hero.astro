---
import { profile } from '../data/profile';
import { asset } from '../lib/url';

const photoSrc = asset(profile.photo);
---

<section class="hero" id="topo">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow">{profile.location}</p>
      <h1 class="hero__name">{profile.name}</h1>
      <p class="hero__role">
        {profile.role} <span class="hero__sep">—</span>
        <span class="hero__focus">{profile.focus}</span>
      </p>
      <p class="hero__tagline">{profile.tagline}</p>

      <div class="hero__actions">
        <a class="button button--primary" href="#projetos">Ver projetos</a>
        <a class="button button--ghost" href={profile.links.linkedin} rel="noopener">
          LinkedIn
        </a>
        <a class="button button--ghost" href={profile.links.github} rel="noopener">
          GitHub
        </a>
      </div>
    </div>

    <img
      class="hero__photo"
      src={photoSrc}
      alt={profile.photoAlt}
      width="200"
      height="200"
      fetchpriority="high"
      decoding="async"
    />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .hero__inner {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .hero__content {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hero__name {
    font-size: var(--step-4);
    font-weight: 700;
  }

  .hero__role {
    margin-top: var(--space-xs);
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--text);
  }

  .hero__sep {
    color: var(--text-faint);
  }

  .hero__focus {
    color: var(--accent);
  }

  .hero__tagline {
    margin-top: var(--space-md);
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .hero__photo {
    flex: 0 0 auto;
    width: 10.5rem;
    height: 10.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .button {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.15rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    font-size: var(--step--1);
    font-weight: 550;
    text-decoration: none;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }

  .button--primary {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .button--primary:hover {
    background: var(--accent-hover);
    color: var(--accent-contrast);
  }

  .button--ghost {
    border-color: var(--border-strong);
    background: var(--bg-elevated);
    color: var(--text);
  }

  .button--ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 46rem) {
    .hero {
      padding-block: var(--space-lg) var(--space-md);
    }

    .hero__inner {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: var(--space-md);
    }

    .hero__photo {
      width: 6.5rem;
      height: 6.5rem;
    }
  }
</style>
