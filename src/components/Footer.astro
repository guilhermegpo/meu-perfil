---
import { navigation, profile } from '../data/profile';
import { asset } from '../lib/url';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

/** Ano de build como valor inicial; `main.ts` troca pelo ano do visitante. */
const year = new Date().getFullYear();
const home = asset('');
const links = navigation.filter((item) => item.id !== 'inicio');
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href={home} aria-label={`${profile.name} — início`}>
          <Logo width={64} />
        </a>
        <p class="footer__tagline">
          {profile.role}
          <span>{profile.areas.join(' · ')}</span>
        </p>
      </div>

      <nav class="footer__nav" aria-label="Rodapé">
        <ul>
          {
            links.map((item) => (
              <li>
                <a class="ulink" href={`${home}#${item.id}`}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="footer__social" aria-label="Contato">
        <li>
          <a href={profile.links.github} rel="noopener" aria-label="GitHub">
            <Icon name="github" />
          </a>
        </li>
        <li>
          <a href={profile.links.linkedin} rel="noopener" aria-label="LinkedIn">
            <Icon name="linkedin" />
          </a>
        </li>
        <li>
          <a href={`mailto:${profile.email}`} aria-label="E-mail">
            <Icon name="mail" />
          </a>
        </li>
      </ul>
    </div>

    <div class="footer__bottom">
      <p>© <span data-year>{year}</span>{' '}{profile.name}.</p>
      <a class="footer__top-link ulink" href="#">
        Voltar ao topo <Icon name="arrow" />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: clamp(2rem, 5vw, 3.25rem) var(--space-md);
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.3));
  }

  /* Filete de luz que separa o rodapé do conteúdo. */
  .footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-strong) 30%, rgba(164, 214, 248, 0.35) 50%, var(--line-strong) 70%, transparent);
  }

  .footer__top {
    display: grid;
    gap: var(--space-md);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .footer__top {
      grid-template-columns: 1fr auto auto;
      gap: var(--space-lg);
    }
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer__logo {
    display: inline-flex;
    opacity: 0.92;
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur) var(--ease);
  }

  .footer__logo:hover {
    opacity: 1;
    transform: scale(1.05);
  }

  .footer__tagline {
    display: grid;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
  }

  .footer__tagline span {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1.35rem;
  }

  .footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .footer__nav a:hover {
    color: var(--text);
  }

  .footer__social {
    display: flex;
    gap: 0.5rem;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    color: var(--text-muted);
    font-size: 1.1rem;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .footer__social a:hover {
    transform: translateY(-2px);
    color: var(--text);
    border-color: var(--line-strong);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    color: var(--text-muted);
  }

  .footer__top-link :global(svg) {
    transform: rotate(-90deg);
  }
</style>
